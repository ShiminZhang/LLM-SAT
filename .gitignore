.env
path_config.yaml
*_.sh

# vendored SDK / heavyweight local artifacts (never commit)
google-cloud-sdk/
KissatEvolve.pdf

# base solver build artifacts
solvers/base/build/
solvers/base/kissat
solvers/base/makefile
solvers/base/COMMIT

# Log files globally, except solver build logs
*.log
!solvers/**/code_*.build.log

# Solver directories - ignore base/legacy/tooling
# solvers/base
solvers/baseline
solvers/test
solvers/kissat
solvers/algorithm_*/

# Heavy solver content - ignore full solver copies, raw eval logs, SLURM batches
solvers/*/slurm_batches/
solvers/**/code_*/
solvers/**/result/

# ignore memory bank stored stuff
src/experience_pool/data/*
!src/experience_pool/data/.gitkeep
# other files
.venv/
dumb_runner.sh
t.txt
solvers/*
!solvers/AE_kissat2025_MAB/
!solvers/AE_kissat2025_MAB/src/**
solvers/AE_kissat2025_MAB/.embedded-git/
!solvers/base/
!solvers/base/src/**
*.pyc
